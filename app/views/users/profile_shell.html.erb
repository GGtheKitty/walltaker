<% content_for(:html_title) { "Walltaker #{@user.username}" } %>

<%= tag.iframe class: 'profile-shell__document',
               src: user_profile_document_path(@user.username),
               title: "#{@user.username}'s Walltaker profile" %>

<% if current_user && !@is_current_user %>
  <aside class="profile-shell__report" aria-label="Profile safety controls">
    <%= turbo_frame_tag :report_button do %>
      <%= render 'reports/control', report: @report, reportable: @user %>
    <% end %>
  </aside>
<% elsif !current_user %>
  <aside class="profile-shell__report" aria-label="Profile safety controls">
    <%= link_to 'Report', login_path, class: 'danger-button button-like', target: '_top', title: 'Log in to report this profile' %>
  </aside>
<% end %>
