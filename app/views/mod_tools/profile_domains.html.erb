<div data-turbo-prefetch="false" class="task-tools">
  <div class="left">
    <%= link_to 'Cancel', mod_tools_index_path %>
  </div>
</div>

<h2>
  <ion-icon role="presentation" name="shield-checkmark" class="big"></ion-icon>
  Profile Domains
  <small><%= pluralize(@pending_profile_domains_pagy.count, 'domain') %> awaiting review</small>
</h2>

<p>
  Unknown domains remain usable while pending. Approving a domain also approves its subdomains. Blocking a domain
  immediately removes matching URLs from saved profiles and removes them from future profile saves. A more-specific
  domain decision takes precedence over its parent domain.
</p>

<section>
  <h3>Awaiting review</h3>
  <% if @pending_profile_domains.any? %>
    <table>
      <thead>
        <tr>
          <th>Domain</th>
          <th>First seen</th>
          <th>Last seen</th>
          <th>Saves</th>
          <th>Decision</th>
        </tr>
      </thead>
      <tbody>
        <% @pending_profile_domains.each do |profile_domain| %>
          <tr id="<%= dom_id(profile_domain) %>">
            <td><code><%= profile_domain.domain %></code></td>
            <td><%= time_ago_in_words(profile_domain.first_seen_at) %> ago</td>
            <td><%= time_ago_in_words(profile_domain.last_seen_at) %> ago</td>
            <td><%= profile_domain.seen_count %></td>
            <td>
              <%= button_to 'Approve', mod_tools_profile_domain_path(profile_domain), method: :patch, params: { profile_domain: { status: 'approved' } }, class: 'secondary' %>
              <%= button_to 'Block', mod_tools_profile_domain_path(profile_domain), method: :patch, params: { profile_domain: { status: 'blocked' } }, class: 'danger-button', form: { data: { turbo_confirm: "Block #{profile_domain.domain} and remove its URLs from all saved profiles?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="center">
      <%== pagy_info(@pending_profile_domains_pagy, item_name: 'domain'.pluralize(@pending_profile_domains_pagy.count)) %>
      <%== pagy_nav(@pending_profile_domains_pagy) if @pending_profile_domains_pagy.pages > 1 %>
    </div>
  <% else %>
    <p>No domains are awaiting review.</p>
  <% end %>
</section>

<section>
  <h3>Approved</h3>
  <% if @approved_profile_domains.any? %>
    <table>
      <thead><tr><th>Domain</th><th>Reviewed by</th><th>Last seen</th><th>Change decision</th></tr></thead>
      <tbody>
        <% @approved_profile_domains.each do |profile_domain| %>
          <tr>
            <td><code><%= profile_domain.domain %></code></td>
            <td><%= profile_domain.reviewed_by&.username || 'Unknown' %></td>
            <td><%= time_ago_in_words(profile_domain.last_seen_at) %> ago</td>
            <td><%= button_to 'Block', mod_tools_profile_domain_path(profile_domain), method: :patch, params: { profile_domain: { status: 'blocked' } }, class: 'danger-button', form: { data: { turbo_confirm: "Block #{profile_domain.domain} and remove its URLs from all saved profiles? This cannot restore URLs later." } } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="center">
      <%== pagy_info(@approved_profile_domains_pagy, item_name: 'domain'.pluralize(@approved_profile_domains_pagy.count)) %>
      <%== pagy_nav(@approved_profile_domains_pagy) if @approved_profile_domains_pagy.pages > 1 %>
    </div>
  <% else %>
    <p>No domains have been approved.</p>
  <% end %>
</section>

<section>
  <h3>Blocked</h3>
  <% if @blocked_profile_domains.any? %>
    <table>
      <thead><tr><th>Domain</th><th>Reviewed by</th><th>Last seen</th><th>Change decision</th></tr></thead>
      <tbody>
        <% @blocked_profile_domains.each do |profile_domain| %>
          <tr>
            <td><code><%= profile_domain.domain %></code></td>
            <td><%= profile_domain.reviewed_by&.username || 'Unknown' %></td>
            <td><%= time_ago_in_words(profile_domain.last_seen_at) %> ago</td>
            <td><%= button_to 'Approve future URLs', mod_tools_profile_domain_path(profile_domain), method: :patch, params: { profile_domain: { status: 'approved' } }, class: 'secondary', form: { data: { turbo_confirm: "Approve #{profile_domain.domain}? Previously removed URLs cannot be restored." } } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="center">
      <%== pagy_info(@blocked_profile_domains_pagy, item_name: 'domain'.pluralize(@blocked_profile_domains_pagy.count)) %>
      <%== pagy_nav(@blocked_profile_domains_pagy) if @blocked_profile_domains_pagy.pages > 1 %>
    </div>
  <% else %>
    <p>No domains have been blocked.</p>
  <% end %>
</section>
