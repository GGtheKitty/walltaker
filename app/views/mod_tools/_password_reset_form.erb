<%= turbo_frame_tag :mod_tools_password_reset_form do %>
  <%= form_with url: mod_tools_passwords_update_path, method: :post do |f| %>
    <%= f.label :email, 'Email address user claims is theirs:', style: "display: block" %>
    <%= f.text_field :email, value: params['email'] %>
    <%= f.submit 'Try to generate a reset link (case insensitive)' %>
    <%= f.submit 'Try to generate a reset link (case sensitive)' %>
  <% end %>

  <% reset_warning = @moderation_reset ? @moderation_reset['warning'] : params['fail'] %>
  <% reset_token = @moderation_reset ? @moderation_reset['token'] : params['link'] %>
  <% reset_username = @moderation_reset ? @moderation_reset['username'] : params['username'] %>
  <% if reset_warning || reset_token %>
    <div class="mod_tool__result mod_tool__result--<%= reset_warning ? 'fail' : 'success' %>">
      <% if reset_warning %>
        <ion-icon name="close-circle" class="big"></ion-icon> <%= reset_warning %><br/>
      <% end %>

      <% if reset_token %>
        <ion-icon name="checkbox" class="big"></ion-icon>
        Found 1 user, <strong><%= reset_username %></strong><br/>
        <code><%= walltaker_url("/i-forgor/commit/#{reset_token}") %></code>
      <% end %>
    </div>
  <% end %>
<% end %>
