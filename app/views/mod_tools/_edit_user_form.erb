<%= turbo_frame_tag :mod_tools_edit_user_form do %>
  <% if user.errors.any? %>
    <p class="flash--danger"><%= user.errors.full_messages.to_sentence %></p>
  <% end %>
  <% if user.deleted? %>
    <div class="accent-block danger spaced">
      <div class="accent-block__charm">
        <ion-icon role="presentation" name="warning"></ion-icon>
        Deleted Account
      </div>
      <p>Original username: <strong><%= user.deleted_username %></strong></p>
      <%= button_to 'Restore Account', mod_tools_users_restore_path(user), class: 'accent-block__button' %>
      <%= button_to 'Permanently Purge Account', mod_tools_users_purge_path(user), method: :delete, class: 'accent-block__button danger-button', form: { data: { turbo_confirm: 'Permanently purge this account and all of its data? This cannot be undone.' } } %>
    </div>
  <% else %>
    <%= button_to "Log in as #{user.username}", mod_tools_users_assume_path(user), method: :post, form: { target: '_top' } %>
  <% end %>
  <%= form_with model: user, method: :post, url: mod_tools_users_update_path do |f| %>
    <%= f.hidden_field :id %>
    <% %w[username email details set_count quarantined flagged is_reporter is_cutie is_supporter].each do |field| %>
      <div>
        <%= f.label field.to_sym %>
        <% if %w[quarantined flagged is_reporter is_cutie is_supporter].include?(field) %>
          <%= f.check_box field.to_sym %>
        <% elsif field == 'details' %>
          <%= f.text_area :details, value: user.advanced? ? user.details : ProfileMarkdown.source(user.details) %>
        <% else %>
          <%= f.text_field field.to_sym, value: user.public_send(field) %>
        <% end %>
      </div>
    <% end %>
    <%= f.submit %>
  <% end %>
<% end %>
