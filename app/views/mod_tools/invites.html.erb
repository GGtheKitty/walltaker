<% content_for(:html_title) { 'Invite Management' } %>

<h2>
  <ion-icon role="presentation" name="ticket"></ion-icon>
  Invites
</h2>

<section>
  <h3>Invite-only mode</h3>
  <p>
    <% if SiteConfig.invite_only? %>
      New accounts require an unused invite code. The shared evil account cannot be logged into.
    <% else %>
      Anyone can create an account without an invite code.
    <% end %>
  </p>
  <%= button_to(
        SiteConfig.invite_only? ? 'Disable invite-only mode' : 'Enable invite-only mode',
        mod_tools_toggle_invite_only_path,
        method: :post,
        class: SiteConfig.invite_only? ? 'secondary' : nil,
        form: { data: { turbo_confirm: "#{SiteConfig.invite_only? ? 'Open registration to everyone?' : 'Require an invite for every new account?'}" } }
      ) %>
</section>

<section>
  <h3>Invite codes</h3>
  <%= button_to 'Generate invite code', mod_tools_invites_path, method: :post %>

  <% if @invite_codes.any? %>
    <table>
      <thead>
        <tr>
          <th>Code</th>
          <th>Status</th>
          <th>Generated by</th>
          <th>Generated</th>
          <th>Redeemed by</th>
          <th>Redeemed</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @invite_codes.each do |invite| %>
          <tr id="<%= dom_id(invite) %>">
            <td><code><%= invite.code %></code></td>
            <td><%= invite.redeemed? ? 'Used' : 'Available' %></td>
            <td><%= invite.generated_by&.username || 'Deleted user' %></td>
            <td><%= time_ago_in_words(invite.created_at) %> ago</td>
            <td><%= invite.redeemed_by&.username || '—' %></td>
            <td><%= invite.redeemed_at ? "#{time_ago_in_words(invite.redeemed_at)} ago" : '—' %></td>
            <td>
              <%= button_to 'Delete', mod_tools_invite_path(invite), method: :delete, class: 'danger-button', form: { data: { turbo_confirm: 'Delete this invite code?' } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No invite codes have been generated.</p>
  <% end %>
</section>

<%= link_to 'Back to Mod Tools', mod_tools_index_path %>
