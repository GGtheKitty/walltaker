<% mascot = current_user&.mascot || 'ki' %>
<% pervert = current_user&.pervert || false %>

<% page_title = content_for?(:html_title) ? yield(:html_title) : "Walltaker" %>
<% embed_title = content_for?(:og_title) ? yield(:og_title) : "(18+) " + page_title %>
<% embed_description = content_for?(:og_description) ? yield(:og_description) : "Take control of your friends wallpapers" %>
<% embed_img = content_for?(:og_image) ? yield(:og_image) : image_url('mascot/KiHead.png') %>
<% theme_color = content_for?(:theme_color) ? yield(:theme_color) : "#ffb300" %>

<!DOCTYPE html>
<html 
  lang="<%= content_for?(:html_lang) ? yield(:html_lang) : 'en' %>
  class="<%= current_user ? "force-#{current_user.colour_preference}" : "" %> <%= "current-mascot-" + mascot %> <%= pervert ? "currently-perverted" : "" %> "
>
<head>
  <title><%= page_title %></title>
  
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= embed_title %>">
  <meta property="og:description" content="<%= embed_description %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:image" content="<%= image_url('mascot/KiHead.png') %>">
  <meta name="theme-color" content="#ffb300">
  
  <%= tag.base target: '_top' if @profile_document %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1">
  <meta name="rating" content="adult"/>
  <meta name="walltaker-base-url" content="<%= walltaker_base_url %>"/>
  <%= favicon_link_tag 'mascot/KiHead.png' if mascot == 'ki' %>
  <%= favicon_link_tag 'mascot/WarrenHead.png' if mascot == 'warren' %>
  <%= favicon_link_tag 'mascot/TaylorHead.png' if mascot == 'taylor' %>
  <link rel="stylesheet" href="/simple.min.css">
  <link rel="stylesheet" href="/base.css?x=<%= ENV['COMMIT_HASH'].presence || File.mtime(Rails.root.join('public/base.css')).to_i %>"/>
  <link rel="stylesheet" href="/link.css?x=<%= ENV['COMMIT_HASH'] %>"/>
  <link rel="stylesheet" href="/dashboard.css?x=<%= ENV['COMMIT_HASH'] %>"/>
  <link rel="stylesheet" href="/user-profile.css?x=<%= ENV['COMMIT_HASH'].presence || File.mtime(Rails.root.join('public/user-profile.css')).to_i %>"/>
  <link rel="stylesheet" href="/member-editor.css?x=<%= ENV['COMMIT_HASH'] %>"/>
  <link rel="stylesheet" href="/messages.css?x=<%= ENV['COMMIT_HASH'] %>"/>
  <link rel="stylesheet" href="/news-room.css?x=<%= ENV['COMMIT_HASH'] %>"/>
  <%= yield :stylesheets %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Lacquer&family=Mrs+Saint+Delafield&family=Vibur&display=swap" rel="stylesheet">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= action_cable_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

  <%= javascript_importmap_tags %>

  <!-- This should use the importmap, but I've broken that beyond repair lol -->
  <script src="https://ga.jspm.io/npm:@github/relative-time-element@4.4.2/dist/index.js" type="module" async></script>
</head>

<body <%= tag.attributes(data: { turbo: false }) if @profile_document %>>
<div data-controller="age">
  <dialog class="modal" data-age-target="modal">
    <h4>This is an adult website</h4>
    <p>Minors cannot use this website. Are you over the age of 18?</p>
    <div class="modal__buttons">
      <%= button_tag class: 'no-underline primary', data: { 'age-target': 'cancel', action: 'click->age#cancel' } do %>
        No
      <% end %>
      <%= button_tag class: 'no-underline secondary', data: { action: 'click->age#dismiss' } do %>
        I am over the age of 18.
      <% end %>
    </div>
  </dialog>
</div>

<%= content_for?(:body) ? yield(:body) : yield %>

<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
<script>
    flatpickr('.flatpickr', {
        enableTime: true,
        dateFormat: 'Z'
    });
</script>
<% if @profile_document %>
  <script>
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
          link.target = '_self'
      })
  </script>
<% end %>
</body>
</html>
