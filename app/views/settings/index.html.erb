<% content_for(:html_title) { "#{@user.username} walltaker settings" } %>

<% if @user.username.last.downcase == 's' %>
  <h2>
    <ion-icon role="presentation" name="person"></ion-icon> <%= @user.username %>' settings
  </h2>
<% else %>
  <h2>
    <ion-icon role="presentation" name="person"></ion-icon> <%= @user.username %>'s settings
  </h2>
<% end %>

<div class="accent-block">
  <div class="accent-block__charm">
    <ion-icon role="img" name="color-palette"></ion-icon>
    Theme Mode
  </div>
  <%= form_with model: @user, url: settings_path, method: :post, data: { 'turbo': 'false' } do |f| %>
    <div class="form__group">
      <%= f.label :colour_preference, value: :light, class: 'form__row' do %>
        <ion-icon role="presentation" name="sunny"></ion-icon>
        Light mode
        <%= f.radio_button :colour_preference, :light %>
      <% end %>
      <%= f.label :colour_preference, value: :dark, class: 'form__row' do %>
        <ion-icon role="presentation" name="moon"></ion-icon>
        Dark mode
        <%= f.radio_button :colour_preference, :dark %>
      <% end %>
      <%= f.label :colour_preference, value: :auto, class: 'form__row' do %>
        <ion-icon role="presentation" name="sparkles"></ion-icon>
        Automatic
        <%= f.radio_button :colour_preference, :auto %>
      <% end %>
    </div>
    <%= f.submit 'Save', class: 'accent-block__button' %>
  <% end %>
</div>

<% unless @user.evil_account? %>
  <div class="accent-block">
    <div class="accent-block__charm">
      <ion-icon role="img" name="person-circle"></ion-icon>
      Username
    </div>
    <small class="settings__username-note">You can only change your username once a week</small>
    <br>
    <% if @user.can_change_username? %>
      <%= form_with model: @user, url: settings_path, method: :post, data: { 'turbo': 'false' } do |f| %>
        <%= hidden_field_tag :settings_action, :username %>
        <div class="form__group">
          <div class="settings__field-grid settings__username-fields">
            <div class="form__row">
              <%= f.label :username %>
              <%= f.text_field :username, autocomplete: 'username' %>
            </div>
          </div>
        </div>
        <%= f.submit 'Change username', class: 'accent-block__button' %>
      <% end %>
    <% else %>
      <p>
        Username changes are available once a week. You can change yours again
        <%= time_tag @user.next_username_change_at, @user.next_username_change_at.to_fs(:long) %>.
      </p>
    <% end %>
  </div>

  <div class="accent-block">
    <div class="accent-block__charm">
      <ion-icon role="img" name="key"></ion-icon>
      Password
    </div>
    <%= form_with model: @user, url: settings_path, method: :post, data: { 'turbo': 'false' } do |f| %>
      <%= hidden_field_tag :settings_action, :password %>
      <div class="form__group">
        <div class="settings__field-grid settings__password-fields">
          <div class="form__row">
            <%= f.label :current_password %>
            <%= f.password_field :current_password, autocomplete: 'current-password', value: nil %>
          </div>
          <div class="form__row">
            <%= f.label :password, 'New password' %>
            <%= f.password_field :password, autocomplete: 'new-password', value: nil %>
          </div>
          <div class="form__row">
            <%= f.label :password_confirmation, 'Confirm new password' %>
            <%= f.password_field :password_confirmation, autocomplete: 'new-password', value: nil %>
          </div>
        </div>
      </div>
      <%= f.submit 'Change password', class: 'accent-block__button' %>
    <% end %>
  </div>
<% end %>
