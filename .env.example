POSTGRES_USER=postgres
POSTGRES_HOST_AUTH_METHOD=trust
DATABASE_URL=postgres://postgres@postgres:5432/walltaker
SECRET_KEY_BASE=replace_with_a_long_random_secret
REDIS_URL=redis://redis:6379/1
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
WALLTAKER_BASE_URL=https://example.com
WALLTAKER_HOST=example.com
PORNBOT_INTERVAL_SECONDS=600

RESEND_API_KEY=re_example_key
RESEND_SMTP_ADDRESS=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USER_NAME=resend
RESEND_SMTP_AUTHENTICATION=plain
RESEND_SMTP_ENABLE_STARTTLS_AUTO=true
WALLTAKER_MAIL_FROM=noreply@example.com
