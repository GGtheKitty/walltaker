SECRET_KEY_BASE=local_development_secret_key_base_quoteMe
WALLPAPER_API_DB_USER=walltaker_api_reader
WALLPAPER_API_DB_PASSWORD=replace_with_a_separate_random_password
WALLPAPER_WRITER_DB_USER=walltaker_wallpaper_writer
WALLPAPER_WRITER_DB_PASSWORD=replace_with_another_random_password
LINK_MANAGER_DB_USER=walltaker_link_manager
LINK_MANAGER_DB_PASSWORD=replace_with_a_separate_management_password
REALTIME_DB_USER=walltaker_realtime
REALTIME_DB_PASSWORD=replace_with_a_separate_presence_password
ACCOUNTS_DB_USER=walltaker_accounts
ACCOUNTS_DB_PASSWORD=replace_with_a_separate_accounts_password
BLAZER_DB_USER=walltaker_blazer_reader
BLAZER_DB_PASSWORD=replace_with_a_separate_blazer_password

#DB
DB_ADMIN_USER=walltaker_admin
DB_ADMIN_PASSWORD=replace_with_a_database_admin_password
DB_HOST=database
DB_NAME=Walltaker
DB_PORT=5432
DB_HOST_PORT=127.0.0.1:5432 # prefix 127.0.0.1: means that the database is only accessible from the host machine. (still reachable by proxy)

# HTTP router bound on localhost behind the TLS proxy
WEB_HOST_PORT=3000

#Cache
CACHE_PORT=6379
CACHE_HOST=redis
CACHE_HOST_PORT=127.0.0.1:6379 # prefix 127.0.0.1: means that the redis is only accessible from the host machine. (still reachable by proxy)
CABLE_HOST_PORT=127.0.0.1:8080

#Walltaker
WALLTAKER_HOST=some.Url.net
WALLTAKER_URL=https://some.Url.net

COMMIT_LINK=https://github.com/Lycraon/walltaker/commit/main

#E621_USER=<your username>
PORNBOT_INTERVAL_SECONDS=600

# Mail (Resend SMTP)
RESEND_API_KEY=re_example_key
RESEND_SMTP_ADDRESS=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USER_NAME=resend
RESEND_SMTP_AUTHENTICATION=plain
RESEND_SMTP_ENABLE_STARTTLS_AUTO=true
WALLTAKER_MAIL_FROM=noreply@example.com

#deployment metadata
COMMIT_HASH=
RELEASE_CREATED_AT=

#Bot Job

#Mail

# Isolated Node social/community database role (provision after db:prepare).
SOCIAL_DB_USER=walltaker_social
SOCIAL_DB_PASSWORD=

# Read-only homepage, Browse and site-search role.
DISCOVERY_DB_USER=walltaker_discovery
DISCOVERY_DB_PASSWORD=

# Tracker/NNN role: separate tracker writes and public statistics; no credentials.
TRACKER_DB_USER=walltaker_tracker
TRACKER_DB_PASSWORD=

# Moderation role: administrative tables and recovery tokens, no password hashes/API keys.
MODERATION_DB_USER=walltaker_moderation
MODERATION_DB_PASSWORD=

# Persistent Node scheduler and worker; no account credentials or wallpaper write access.
AUTOMATION_DB_USER=walltaker_automation
AUTOMATION_DB_PASSWORD=

# Activity history and analytics: isolated visit/event/history persistence.
ACTIVITY_DB_USER=walltaker_activity
ACTIVITY_DB_PASSWORD=

# Node browser reads and revocable sessions (provision with scripts/provision-browser.sh).
BROWSER_DB_USER=walltaker_browser
BROWSER_DB_PASSWORD=replace-with-a-long-random-password

# Node rendering and durable delivery handoff. Enable after provisioning and verification.
DELIVERY_DB_USER=walltaker_delivery
DELIVERY_DB_PASSWORD=replace-with-a-long-random-password
